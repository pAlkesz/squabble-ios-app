rules_version = '2';

// Layout (see CLAUDE.md, "Firestore data model"):
//   users/{uid}                 public profile — any signed-in user can read it
//   users/{uid}/private/payment owner-only payment methods
//   users/{uid}/private/preferences owner-only settings (home currency)
//   handles/{handle}            { uid } — the lock that keeps handles unique
//   groups/{groupId}            a squabble — readable by its current members (docs/specs/groups.md)
//
// Deploy: firebase deploy --only firestore:rules,storage
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function handlePath(handle) {
      return /databases/$(database)/documents/handles/$(handle);
    }

    function userPath(uid) {
      return /databases/$(database)/documents/users/$(uid);
    }

    function isValidAvatar(avatar, uid) {
      return avatar is map && (
        (avatar.kind == 'preset'
          && avatar.keys().hasOnly(['kind', 'preset'])
          && avatar.preset in ['meadow', 'lagoon', 'coral', 'mustard', 'plum', 'tangerine', 'rose', 'indigo', 'olive', 'slate', 'cocoa'])
        // Checked by shape, not a list, so new personas ship without a rules deploy;
        // an app that doesn't know one shows the bird instead.
        || (avatar.kind == 'persona'
          && avatar.keys().hasOnly(['kind', 'persona', 'color'])
          && avatar.persona is string
          && avatar.persona.matches('[a-zA-Z0-9]{1,40}')
          && avatar.color in ['meadow', 'lagoon', 'coral', 'mustard', 'plum', 'tangerine', 'rose', 'indigo', 'olive', 'slate', 'cocoa'])
        || (avatar.kind == 'photo'
          && avatar.keys().hasOnly(['kind', 'path', 'url'])
          && avatar.path is string
          && avatar.path.matches('avatars/' + uid + '/[^/]+[.]jpg')
          && avatar.url is string
          // The iOS SDK spells out the port in download URLs.
          && avatar.url.matches('https://firebasestorage[.]googleapis[.]com(:443)?/.*'))
      );
    }

    // The app caps names at 50 characters; rules count differently for emoji, so
    // leave headroom and only stop abuse here.
    function isValidProfile(data, uid) {
      return data.keys().hasOnly(['displayName', 'handle', 'avatar', 'createdAt', 'updatedAt'])
        && data.displayName is string
        && data.displayName.size() > 0
        && data.displayName.size() <= 100
        && data.handle is string
        && isValidAvatar(data.avatar, uid);
    }

    match /users/{uid} {
      allow read: if signedIn();
      // The profile must point at a handle this user holds once the write lands,
      // which forces the handle claim into the same transaction.
      allow create, update: if isUser(uid)
        && isValidProfile(request.resource.data, uid)
        && getAfter(handlePath(request.resource.data.handle)).data.uid == uid;
      allow delete: if isUser(uid);

      match /private/{document} {
        allow read, delete: if isUser(uid);
        allow create, update: if isUser(uid) && (
          (document == 'payment'
            && request.resource.data.keys().hasOnly(['methods'])
            && request.resource.data.methods is list
            && request.resource.data.methods.size() <= 5)
          // No homeCurrency means "follow the device".
          || (document == 'preferences'
            && request.resource.data.keys().hasOnly(['homeCurrency'])
            && (!('homeCurrency' in request.resource.data)
              || (request.resource.data.homeCurrency is string
                && request.resource.data.homeCurrency.matches('[A-Z]{3}'))))
        );
      }
    }

    // A member's copy of their own profile and payment details. `joinedAt` is the server's
    // clock at creation; `leftAt` and `deleted` are only ever written by the server.
    function isValidMemberEntry(entry, uid) {
      return entry is map
        && entry.keys().hasOnly(['displayName', 'handle', 'avatar', 'payment', 'joinedAt'])
        && entry.displayName is string
        && entry.displayName.size() > 0
        && entry.displayName.size() <= 100
        && (!('handle' in entry) || (entry.handle is string && entry.handle.matches('[a-z0-9_]{3,32}')))
        && isValidAvatar(entry.avatar, uid)
        && (!('payment' in entry) || (entry.payment is list && entry.payment.size() <= 5));
    }

    // An emoji on one of the avatar colours, or a photo the creator uploaded to their own
    // groupImages/ folder.
    function isValidSquabbleImage(image, uid) {
      return image is map && (
        (image.kind == 'emoji'
          && image.keys().hasOnly(['kind', 'emoji', 'color'])
          && image.emoji is string
          && image.emoji.size() > 0
          && image.emoji.size() <= 40
          && image.color in ['meadow', 'lagoon', 'coral', 'mustard', 'plum', 'tangerine', 'rose', 'indigo', 'olive', 'slate', 'cocoa'])
        || (image.kind == 'photo'
          && image.keys().hasOnly(['kind', 'path', 'url'])
          && image.path is string
          && image.path.matches('groupImages/' + uid + '/[^/]+[.]jpg')
          && image.url is string
          && image.url.matches('https://firebasestorage[.]googleapis[.]com(:443)?/.*'))
      );
    }

    // See docs/specs/groups.md. Only what the app does so far is allowed: creating a
    // squabble and keeping your own entry current. Leaving, archiving and deleting come
    // with their screens; joining by invite goes through a Cloud Function.
    match /groups/{groupId} {
      // The "my groups" query asks for memberIds array-contains the caller, which this
      // rule can vouch for.
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;

      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'currency', 'image', 'createdBy', 'createdAt', 'updatedAt', 'memberIds', 'members'])
        && (!('image' in request.resource.data) || isValidSquabbleImage(request.resource.data.image, request.auth.uid))
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 100
        && request.resource.data.currency is string
        && request.resource.data.currency.matches('[A-Z]{3}')
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.memberIds[0] == request.auth.uid
        && request.resource.data.members is map
        && request.resource.data.members.keys().toSet() == request.resource.data.memberIds.toSet()
        && request.resource.data.members.keys().size() == request.resource.data.memberIds.size()
        && isValidMemberEntry(request.resource.data.members[request.auth.uid], request.auth.uid);

      // A member rewrites their own entry only, and never in an archived squabble.
      allow update: if signedIn()
        && request.auth.uid in resource.data.memberIds
        && !('archivedAt' in resource.data)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid])
        && request.resource.data.members[request.auth.uid].get('joinedAt', null)
          == resource.data.members[request.auth.uid].get('joinedAt', null)
        && isValidMemberEntry(request.resource.data.members[request.auth.uid], request.auth.uid);
    }

    match /handles/{handle} {
      allow read: if signedIn();
      // No updates: a handle is released (deleted) and claimed again, never transferred.
      allow create: if signedIn()
        && handle.matches('[a-z0-9_]{3,32}')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(userPath(request.auth.uid)).data.handle == handle;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
  }
}
