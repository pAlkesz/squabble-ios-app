    "Taken. Someone got there first." : {
      "comment" : "Onboarding: handle is taken.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Foglalt. Valaki gyorsabb volt."
          }
        }
      }
    },
    "That doesn't look like a username." : {
      "comment" : "PaymentLinkError.invalidUsername",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez nem néz ki felhasználónévnek."
          }
        }
      }
    },
    "That IBAN doesn't add up. Check for a typo." : {
      "comment" : "IBANError.checksumMismatch",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez az IBAN nem stimmel. Nézd meg, nincs-e elütés."
          }
        }
      }
    },
    "That link is for a different service." : {
      "comment" : "PaymentLinkError.wrongProvider",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a link egy másik szolgáltatáshoz tartozik."
          }
        }
      }
    },
    "That picture didn't work. Try a different one." : {
      "comment" : "ProfileError.invalidImage",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a kép nem jött össze. Próbálj egy másikat."
          }
        }
      }
    },
    "That's not the right length for an IBAN." : {
      "comment" : "IBANError.wrongLength",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ilyen hosszú IBAN nem létezik."
          }
        }
      }
    },
    "This is the name on every bill — and on every reminder that you're owed money." : {
      "comment" : "Onboarding: name step subtitle.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a név áll majd minden számlán — és minden emlékeztetőn, hogy tartoznak neked."
          }
        }
      }
    },
    "This wipes your account and everything in it. Your friends will still owe you money — that part's between you and them." : {
      "comment" : "Confirmation dialog message before account deletion.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez törli a fiókod és mindent, ami benne van. A barátaid ettől még tartoznak neked — az már a ti dolgotok."
          }
        }
      }
    },
    "TOTAL" : {
      "comment" : "Prop receipt total row label.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ÖSSZESEN"
          }
        }
      }
    },
