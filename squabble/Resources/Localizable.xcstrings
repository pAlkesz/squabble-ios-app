    "Confirm with Apple to delete your account." : {
      "comment" : "Re-authentication sheet heading before deletion.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erősítsd meg Apple-lel a fiók törlését."
          }
        }
      }
    },
    "Continue" : {
      "comment" : "Confirmation dialog proceed button.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folytatás"
          }
        }
      }
    },
    "Couldn't check this handle. Tap the arrow to try again." : {
      "comment" : "Onboarding: handle check failed (not offline); the retry arrow sits at the end of the field.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült ellenőrizni a felhasználónevet. Koppints a nyílra, és újrapróbáljuk."
          }
        }
      }
    },
    "Delete account" : {
      "comment" : "Account screen destructive button.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiók törlése"
          }
        }
      }
    },
    "Delete your account?" : {
      "comment" : "Confirmation dialog title.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törlöd a fiókod?"
          }
        }
      }
    },
    "Display name" : {
      "comment" : "Onboarding: field title.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megjelenített név"
          }
        }
      }
    },
    "Doesn't have to be unique. Your friends know who you are." : {
      "comment" : "Onboarding: display name hint.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem kell egyedinek lennie. A barátaid tudják, ki vagy."
          }
        }
      }
    },
    "Done" : {
      "comment" : "Dismiss button on sheets.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kész"
          }
        }
      }
    },
    "Finish" : {
      "comment" : "Onboarding: final button once payment methods were added.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kész"
          }
        }
      }
    },
    "FREE. THE FALLOUT ISN'T." : {
      "comment" : "Receipt footer — the app is free, the consequences are not.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "INGYENES. A KÖVETKEZMÉNY NEM."
          }
        }
      }
    },
    "Handle" : {
      "comment" : "Onboarding: field title for the unique @handle.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felhasználónév"
          }
        }
      }
    },
    "handle" : {
      "comment" : "Onboarding: handle placeholder (ASCII only).",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "felhasznalonev"
          }
        }
      }
    },
    "I didn't get state funding, my company did" : {
      "comment" : "Avatar persona slogan: a famous non-denial. Hungarian original: 'Én nem kaptam állami támogatást, a cégem kapott'.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én nem kaptam állami támogatást, a cégem kapott"
          }
        }
      }
    },
    "I know everything about art" : {
      "comment" : "Avatar persona slogan: the self-declared connoisseur. Hungarian original: 'Mindent tudok a művészetről'.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindent tudok a művészetről"
          }
        }
      }
    },
    "I'll bite a chunk out of your ass" : {
      "comment" : "Avatar persona slogan: a rapper's threat. Hungarian original: 'Kiharapok egy darabot a seggedből'.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiharapok egy darabot a seggedből"
          }
        }
      }
    },
    "I'll pay you back after payday" : {
      "comment" : "Avatar persona slogan: always broke until the next salary. Hungarian original: 'Majd ötödike után megadom'.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Majd ötödike után megadom"
          }
        }
      }
    },
    "IBAN: %@" : {
      "comment" : "Payment method editor: the typed account number as an IBAN.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBAN: %@"
          }
        }
      }
    },
    "If I'm too much for you, you're not enough for me" : {
      "comment" : "Avatar persona slogan: unapologetically a lot. Hungarian original: 'Akinek én sok vagyok, az nekem kevés'.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akinek én sok vagyok, az nekem kevés"
          }
        }
      }
    },
    "If you've got nothing, that's what you're worth" : {
      "comment" : "Avatar persona slogan: a well-known Hungarian political quote, 'Akinek nincs semmije, az annyit is ér'.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akinek nincs semmije, az annyit is ér"
          }
        }
      }
    },
    "Jesus was an actor" : {
      "comment" : "Avatar persona slogan: a quotable actor. Hungarian original: 'Jézus színész volt'.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jézus színész volt"
          }
        }
      }
    },
    "Keep for your records. Or don't." : {
      "comment" : "Payment slip: small print under the title.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Őrizd meg. Vagy ne."
          }
        }
      }
    },
    "Loading…" : {
      "comment" : "VoiceOver: the launch splash is waiting for the app to load.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Töltöm…"
          }
        }
      }
    },
    "Money is no object" : {
      "comment" : "Avatar persona slogan: the big spender.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A pénz nem számít"
          }
        }
      }
    },
    "Name on the account" : {
      "comment" : "Payment editor: holder name placeholder.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A számlán szereplő név"
          }
        }
      }
    },
    "Nice, it's all yours." : {
      "comment" : "Onboarding: handle is available.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szuper, ez a tiéd."
          }
        }
      }
    },
    "Nobody can pay you yet. Very convenient for them." : {
      "comment" : "Payment slip: shown before any payment method is added.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még senki sem tud fizetni neked. Nekik ez igazán kényelmes."
          }
        }
      }
    },
    "Nothing to squabble about yet." : {
      "comment" : "Home empty-state title.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még nincs min veszekedni."
          }
        }
      }
    },
    "OK" : {
      "comment" : "Alert dismiss button.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "OK"
          }
        }
      }
    },
    "Only a–z, 0–9 and underscores." : {
      "comment" : "HandleError.invalidCharacters",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak a–z, 0–9 és alulvonás. Ékezet nélkül, bocs."
          }
        }
      }
    },
    "Only people you split bills with can see these. You can change them any time." : {
      "comment" : "Onboarding: payment privacy note.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak azok látják, akikkel számlát osztasz. Bármikor módosíthatod."
          }
        }
      }
    },
    "Only people you split bills with will see this." : {
      "comment" : "Payment editor: IBAN privacy hint.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csak azok látják, akikkel számlát osztasz."
          }
        }
      }
    },
    "OPEN TAB · 3 GUESTS" : {
      "comment" : "Prop receipt subheader.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "NYITOTT SZÁMLA · 3 FŐ"
          }
        }
      }
    },
    "Optional. Add a bank account or a payment link, and “I didn’t know how to pay you” stops being an excuse." : {
      "comment" : "Onboarding: payment step subtitle.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem kötelező. Adj meg egy bankszámlát vagy fizetési linket, és a „nem tudtam, hová utaljak” többé nem kifogás."
          }
        }
      }
    },
    "PAYMENT SLIP" : {
      "comment" : "Payment slip: printed title. In Hungarian, the yellow cheque everyone knows.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "CSEKK"
          }
        }
      }
    },
    "Petty reminders" : {
      "comment" : "Receipt line item — an app feature, priced at zero.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kicsinyes emlékeztetők"
          }
        }
      }
    },
    "Pick who you'll be when the bill comes. Or show your actual face — people pay faster when they can see who's asking." : {
      "comment" : "Onboarding avatar step: subtitle.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válaszd ki, ki leszel, amikor megjön a számla. Vagy mutasd az igazi arcod – gyorsabban fizetnek, ha látják, ki kéri."
          }
        }
      }
    },
    "Profiles aren't available in this build." : {
      "comment" : "ProfileError.unavailable",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ebben a buildben nincsenek profilok."
          }
        }
      }
    },
    "Put a face to the debt" : {
      "comment" : "Onboarding: avatar step title.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legyen arca az adósságnak"
          }
        }
      }
    },
    "Remove" : {
      "comment" : "Payment method row: delete button accessibility label.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Eltávolítás"
          }
        }
      }
    },
    "Scan the receipt" : {
      "comment" : "Receipt line item — an app feature, priced at zero.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Blokk beolvasása"
          }
        }
      }
    },
    "Sign out" : {
      "comment" : "Sign-out button — account screen, and the profile-failed sheet.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kijelentkezés"
          }
        }
      }
    },
    "Sign-in failed" : {
      "comment" : "Alert title when Sign in with Apple fails.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült bejelentkezni"
          }
        }
      }
    },
    "Sign-in isn't available in this build." : {
      "comment" : "AuthError.unavailable — Firebase config missing.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A bejelentkezés ebben a buildben nem elérhető."
          }
        }
      }
    },
    "Skip for now" : {
      "comment" : "Onboarding: final button when no payment method was added.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Most kihagyom"
          }
        }
      }
    },
    "Skip intro" : {
