    },
    "Pick a bird or use a photo. People pay faster when they can see who's asking." : {
      "comment" : "Onboarding: avatar step subtitle.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Válassz egy madarat vagy egy fotót. Gyorsabban fizetnek, ha látják, ki kéri."
