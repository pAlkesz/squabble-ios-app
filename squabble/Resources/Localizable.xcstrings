        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ hozzáadta ezt: „%2$@”"
          }
        }
      }
    },
    "%@ deleted a message" : {
      "comment" : "Squabble row: the latest message was deleted by its author.",
