{
  "sourceLanguage": "en",
  "strings": {
    "\"Next one's on me\"": {
      "comment": "Prop receipt line item — the classic lie, priced at zero.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "„Majd én fizetek”"
          }
        }
      }
    },
    "A joke receipt: nachos, Dave's third beer, emotional damage. Total: friendship.": {
      "comment": "VoiceOver description of the decorative welcome-screen receipt.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Vicces számla: nachos, Dave harmadik söre, lelki kár. Végösszeg: barátság."
          }
        }
      }
    },
    "Account": {
      "comment": "Account screen title and toolbar button.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiók"
          }
        }
      }
    },
    "Add a bill and we'll find something.": {
      "comment": "Home empty-state description.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Adj hozzá egy számlát, találunk okot."
          }
        }
      }
    },
    "Annoys the bird.": {
      "comment": "VoiceOver hint for the tappable welcome-screen bird.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Felbosszantja a madarat."
          }
        }
      }
    },
    "Anonymous squab": {
      "comment": "Shown instead of the name when Apple didn't share one.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Névtelen fióka"
          }
        }
      }
    },
    "Apple didn't return an authorization code.": {
      "comment": "AuthError.missingAuthorizationCode",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple nem küldött engedélyezési kódot."
          }
        }
      }
    },
    "Apple didn't return an identity token.": {
      "comment": "AuthError.missingIdentityToken",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple nem küldött azonosító tokent."
          }
        }
      }
    },
    "Cancel": {
      "comment": "Generic cancel button.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mégse"
          }
        }
      }
    },
    "Confirm with Apple to delete your account.": {
      "comment": "Re-authentication sheet heading before deletion.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Erősítsd meg Apple-lel a fiók törlését."
          }
        }
      }
    },
    "Continue": {
      "comment": "Confirmation dialog proceed button.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Folytatás"
          }
        }
      }
    },
    "Dave's 3rd beer": {
      "comment": "Prop receipt line item.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Dave 3. söre"
          }
        }
      }
    },
    "Delete account": {
      "comment": "Account screen destructive button.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiók törlése"
          }
        }
      }
    },
    "Delete your account?": {
      "comment": "Confirmation dialog title.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Törlöd a fiókod?"
          }
        }
      }
    },
    "Done": {
      "comment": "Dismiss button on sheets.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kész"
          }
        }
      }
    },
    "Emotional damage": {
      "comment": "Prop receipt line item.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Lelki kár"
          }
        }
      }
    },
    "NO REFUNDS · NO MERCY": {
      "comment": "Prop receipt footer.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "NINCS PÉNZVISSZA · NINCS PARDON"
          }
        }
      }
    },
    "Nachos": {
      "comment": "Prop receipt line item.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nachos"
          }
        }
      }
    },
    "Nothing to squabble about yet.": {
      "comment": "Home empty-state title.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Még nincs min veszekedni."
          }
        }
      }
    },
    "OK": {
      "comment": "Alert dismiss button.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        }
      }
    },
    "SQUABBLE": {
      "comment": "Receipt header on the welcome screen; uppercase on purpose.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "SQUABBLE"
          }
        }
      }
    },
    "Sign out": {
      "comment": "Account screen button.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kijelentkezés"
          }
        }
      }
    },
    "Sign-in failed": {
      "comment": "Alert title when Sign in with Apple fails.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem sikerült bejelentkezni"
          }
        }
      }
    },
    "Sign-in isn't available in this build.": {
      "comment": "AuthError.unavailable — Firebase config missing.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejelentkezés ebben a buildben nem elérhető."
          }
        }
      }
    },
    "Skip intro": {
      "comment": "VoiceOver action to skip the launch animation.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Intró kihagyása"
          }
        }
      }
    },
    "Something went wrong": {
      "comment": "Generic alert title on the account screen.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Valami elromlott"
          }
        }
      }
    },
    "Split the bill. Assign the blame.": {
      "comment": "Sign-in tagline.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Oszd el a számlát. Oszd ki a felelősséget."
          }
        }
      }
    },
    "Squabble": {
      "comment": "App name, read by VoiceOver on the launch splash and the welcome-screen bird.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Squabble"
          }
        }
      }
    },
    "TABLE 4 · 3 GUESTS": {
      "comment": "Prop receipt subheader.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "4. ASZTAL · 3 FŐ"
          }
        }
      }
    },
    "TOTAL": {
      "comment": "Prop receipt total row label.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "ÖSSZESEN"
          }
        }
      }
    },
    "This wipes your account and everything in it. Your friends will still owe you money — that part's between you and them.": {
      "comment": "Confirmation dialog message before account deletion.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ez törli a fiókod és mindent, ami benne van. A barátaid ettől még tartoznak neked — az már a ti dolgotok."
          }
        }
      }
    },
    "You're not signed in.": {
      "comment": "AuthError.notSignedIn",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nem vagy bejelentkezve."
          }
        }
      }
    },
    "friendship": {
      "comment": "Prop receipt total amount — the joke payoff.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "barátság"
          }
        }
      }
    },
    "you had one": {
      "comment": "Prop receipt note under the nachos line.",
      "localizations": {
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "egyet ettél belőle"
          }
        }
      }
    }
  },
  "version": "1.0"
}
