          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem vagy bejelentkezve."
          }
        }
      }
    },
    "You're offline, and the photo needs the internet. Remove it to create the squabble now, or try again when you're back." : {
      "comment" : "Create squabble: tried to create with a photo while offline.",
