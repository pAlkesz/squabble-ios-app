    "Clear name" : {
      "comment" : "Create squabble: VoiceOver label for the button that empties the name field.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Név törlése"
          }
        }
      }
    },
    "Colour" : {
      "comment" : "Squabble emoji picker: header above the colours.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szín"
          }
        }
      }
    },
    "Confirm with Apple and your profile, payment details and photos are gone for good. No undo — not even we can bring them back." : {
      "comment" : "Delete account sheet: description above the Apple button.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Erősítsd meg Apple-lel, és a profilod, a fizetési adataid meg a fotóid végleg eltűnnek. Visszavonás nincs — még mi sem tudjuk visszahozni őket."
          }
        }
      }
    },
    "Continue" : {
      "comment" : "Confirmation dialog proceed button.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Folytatás"
          }
        }
      }
    },
    "Coral" : {
      "comment" : "Colour name, read by VoiceOver in colour pickers.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Korall"
          }
        }
      }
    },
    "Couldn't check this handle. Tap the arrow to try again." : {
      "comment" : "Onboarding: handle check failed (not offline); the retry arrow sits at the end of the field.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem sikerült ellenőrizni a felhasználónevet. Koppints a nyílra, és újrapróbáljuk."
          }
        }
      }
    },
    "Create squabble" : {
      "comment" : "Create squabble sheet: title.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veszekedés indítása"
          }
        }
      }
    },
    "Currency" : {
      "comment" : "Create squabble: label on the currency row, and the currency picker's title.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pénznem"
          }
        }
      }
    },
    "Default currency" : {
      "comment" : "Account screen row and page title: the currency the home total is shown in.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Alapértelmezett pénznem"
          }
        }
      }
    },
    "Delete account" : {
      "comment" : "Account screen destructive button.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiók törlése"
          }
        }
      }
    },
    "Delete your account?" : {
      "comment" : "Confirmation dialog title.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Törlöd a fiókod?"
          }
        }
      }
    },
    "Dinner" : {
      "comment" : "Squabble name preset: a meal out.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vacsora"
          }
        }
      }
    },
    "Display name" : {
      "comment" : "Onboarding: field title.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megjelenített név"
          }
        }
      }
    },
    "Doesn't have to be unique. Your friends know who you are." : {
      "comment" : "Onboarding: display name hint.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nem kell egyedinek lennie. A barátaid tudják, ki vagy."
          }
        }
      }
    },
    "Emoji" : {
      "comment" : "Squabble emoji picker: header above the emojis, and its title.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Emoji"
          }
        }
      }
    },
    "Everyone pays up" : {
      "comment" : "Membership card: the joke expiry date.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Amíg mindenki nem fizet"
          }
        }
      }
    },
    "Everyone's balance shows up in this currency." : {
      "comment" : "New squabble: footer under the currency row.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindenki egyenlegét ebben a pénznemben mutatjuk."
          }
        }
      }
    },
    "Family" : {
      "comment" : "Squabble name preset: family expenses.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Család"
          }
        }
      }
    },
    "Finish" : {
      "comment" : "Onboarding: final button once payment methods were added.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kész"
          }
        }
      }
    },
    "Flat" : {
      "comment" : "Squabble name preset: a shared flat or house.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Albérlet"
          }
        }
      }
    },
    "Follows your phone's region. Totals are converted into this currency, so pick the one your bank account thinks in." : {
      "comment" : "Home currency picker: footer under the Automatic row.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A telefonod régióját követi. Az összesítők ebbe a pénznembe váltódnak át, szóval azt válaszd, amiben a bankszámlád gondolkodik."
          }
        }
      }
    },
    "FREE. THE FALLOUT ISN'T." : {
      "comment" : "Receipt footer — the app is free, the consequences are not.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "INGYENES. A KÖVETKEZMÉNY NEM."
          }
        }
      }
    },
    "Give the squabble a name, 50 characters at most." : {
      "comment" : "Error when creating a squabble without a valid name.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj nevet a veszekedésnek, legfeljebb 50 karakterben."
          }
        }
      }
    },
    "Green" : {
      "comment" : "Colour name, read by VoiceOver in colour pickers.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zöld"
          }
        }
      }
    },
    "handle" : {
      "comment" : "Onboarding: handle placeholder (ASCII only).",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "felhasznalonev"
          }
        }
      }
    },
    "Handle" : {
      "comment" : "Onboarding: field title for the unique @handle.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felhasználónév"
          }
        }
      }
    },
    "I didn't get state funding, my company did" : {
      "comment" : "Avatar persona slogan: a famous non-denial. Hungarian original: 'Én nem kaptam állami támogatást, a cégem kapott'.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Én nem kaptam állami támogatást, a cégem kapott"
          }
        }
      }
    },
    "I know everything about art" : {
      "comment" : "Avatar persona slogan: the self-declared connoisseur. Hungarian original: 'Mindent tudok a művészetről'.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindent tudok a művészetről"
          }
        }
      }
    },
    "I'll bite a chunk out of your ass" : {
      "comment" : "Avatar persona slogan: a rapper's threat. Hungarian original: 'Kiharapok egy darabot a seggedből'.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kiharapok egy darabot a seggedből"
          }
        }
      }
    },
    "I'll pay you back after payday" : {
      "comment" : "Avatar persona slogan: always broke until the next salary. Hungarian original: 'Majd ötödike után megadom'.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Majd ötödike után megadom"
          }
        }
      }
    },
    "IBAN: %@" : {
      "comment" : "Payment method editor: the typed account number as an IBAN.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "IBAN: %@"
          }
        }
      }
    },
    "If I'm too much for you, you're not enough for me" : {
      "comment" : "Avatar persona slogan: unapologetically a lot. Hungarian original: 'Akinek én sok vagyok, az nekem kevés'.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akinek én sok vagyok, az nekem kevés"
          }
        }
      }
    },
    "If you've got nothing, that's what you're worth" : {
      "comment" : "Avatar persona slogan: a well-known Hungarian political quote, 'Akinek nincs semmije, az annyit is ér'.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Akinek nincs semmije, az annyit is ér"
          }
        }
      }
    },
    "Indigo" : {
      "comment" : "Colour name, read by VoiceOver in colour pickers.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indigó"
          }
        }
      }
    },
    "Jesus was an actor" : {
      "comment" : "Avatar persona slogan: a quotable actor. Hungarian original: 'Jézus színész volt'.",
      "localizations" : {
