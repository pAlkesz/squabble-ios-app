{
  "sourceLanguage" : "en",
  "strings" : {
    "20 characters max. Nobody's typing all that." : {
      "comment" : "HandleError.tooLong",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legfeljebb 20 karakter. Ezt senki nem fogja begépelni."
          }
        }
      }
    },
    "40 characters max. It has to fit on a receipt." : {
      "comment" : "Onboarding: display name too long.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legfeljebb 40 karakter. Rá kell férnie a blokkra."
          }
        }
      }
    },
    "A receipt listing what Squabble does — split any bill, scan the receipt, work out who owes what, send petty reminders — every line free, total zero." : {
      "comment" : "VoiceOver description of the decorative welcome-screen receipt.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Számla arról, mit tud a Squabble: számla elosztása, blokk beolvasása, ki mivel tartozik, kicsinyes emlékeztetők — minden tétel ingyen, a végösszeg nulla."
          }
        }
      }
    },
    "Account" : {
      "comment" : "Account screen title and toolbar button.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fiók"
          }
        }
      }
    },
    "Account holder" : {
      "comment" : "Payment editor: field title for the bank account holder's name.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Számlatulajdonos"
          }
        }
      }
    },
    "Add" : {
      "comment" : "Payment editor: confirm button.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hozzáadás"
          }
        }
      }
    },
    "Add a bill and we'll find something." : {
      "comment" : "Home empty-state description.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adj hozzá egy számlát, találunk okot."
          }
        }
      }
    },
    "Add a way to pay you" : {
      "comment" : "Button and sheet title for adding a payment method.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fizetési mód hozzáadása"
          }
        }
      }
    },
    "An IBAN starts with a country code, like HU or DE." : {
      "comment" : "IBANError.invalidFormat",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az IBAN országkóddal kezdődik, például HU vagy DE."
          }
        }
      }
    },
    "Annoys the bird." : {
      "comment" : "VoiceOver hint for the tappable welcome-screen bird.",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Felbosszantja a madarat."
          }
        }
      }
    },
    "Apple didn't return an authorization code." : {
      "comment" : "AuthError.missingAuthorizationCode",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Apple nem küldött engedélyezési kódot."
          }
        }
      }
    },
    "Apple didn't return an identity token." : {
      "comment" : "AuthError.missingIdentityToken",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Apple nem küldött azonosító tokent."
          }
        }
      }
    },
    "At least 3 characters. Even birds have longer names." : {
      "comment" : "HandleError.tooShort",
      "localizations" : {
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legalább 3 karakter. Még a madaraknak is hosszabb nevük van."
          }
        }
      }
    },
    "Back" : {
